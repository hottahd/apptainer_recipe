Bootstrap: docker
From: condaforge/miniforge3:latest

%labels
    Author Hideyuki Hotta
    Version v0.1.0

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    # conda install
    mamba update -y conda
    mamba update --all
    mamba clean -a
    
    # apt install
    ## general libraries
    apt-get -y update && apt-get -y install --no-install-recommends git build-essential gfortran
    rm -rf /var/lib/apt/lists/*

    # ----- Prompt setting (force singularity to use the custom prompt)
    CUSTOM_ENV=/.singularity.d/env/99-zz_custom_env.sh
    cat >$CUSTOM_ENV <<EOF
#!/bin/bash
PS1="\[\e[1;33m\](sing):\h:\[\e[0;36m\]\w# \[\e[m\]"
EOF

%test
    set -eu
    # ☠★%test は読み取り専用・HOME=/root で走る★☠（2026-09-17 に踏んだ）
    #   matplotlib も sunpy も設定ディレクトリを作ろうとして落ちるので、/tmp へ逃がす
    export HOME=/tmp MPLCONFIGDIR=/tmp/mpl SUNPY_CONFIGDIR=/tmp/sunpy \
           XDG_CONFIG_HOME=/tmp XDG_CACHE_HOME=/tmp
    python -c "import sys; print('  ok: python', sys.version.split()[0])"
    gfortran --version | head -1
