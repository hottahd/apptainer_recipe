Bootstrap: docker
From: almalinux:8

%labels
    Author Hideyuki Hotta
    Version v0.1.0

%post
    REPO1="--enablerepo powertools"

    # prequisite
    yum install -y which
    yum install -y epel-release

    # install jwt-agent
    yum install -y $REPO1 golang git make pandoc
    git clone https://github.com/oss-tsukuba/jwt-agent.git
    cd jwt-agent
    make
    make PREFIX=/usr/local install

    # install oidc-agent
    yum update -y
    yum install -y $REPO1 \
    make \
    gcc \
    gcc-c++

    yum install -y $REPO1 \
    libcurl-devel \
    libsodium-devel \
    libmicrohttpd-devel \
    libsecret-devel \
    qrencode-devel \
    webkitgtk4-devel \
    help2man
    OIDC_AGENT_VERSION=4.5.2
    OIDC_AGENT_NAME=oidc-agent-${OIDC_AGENT_VERSION}
    OIDC_AGENT_URL=https://github.com/indigo-dc/oidc-agent/archive/refs/tags/v${OIDC_AGENT_VERSION}.tar.gz
    curl -o ${OIDC_AGENT_NAME}.tar.gz -L ${OIDC_AGENT_URL}
    tar xvf ${OIDC_AGENT_NAME}.tar.gz
    cd ${OIDC_AGENT_NAME}
    sed -i 's/DEFINE_USE_CJSON_SO =/#DEFINE_USE_CJSON_SO =/g' Makefile
    sed -i 's/DEFINE_USE_LIST_SO =/#DEFINE_USE_LIST_SO =/g' Makefile
    sed -i 's/DEFINE_USE_MUSTACHE_SO =/#DEFINE_USE_MUSTACHE_SO =/g' Makefile
    sed -i 's/@ln -s /@ln -sf /g' Makefile
    make
    make install_lib
    make install
    cat <<EOF | tee /etc/ld.so.conf.d/oidc-agent.conf
/usr/lib/x86_64-linux-gnu
EOF
    ldconfig

    # install hpcissh-clients
    git clone https://github.com/hpci-auth/hpcissh-clients.git
    yum install -y sshpass jq
    cd hpcissh-clients
    ./install.sh /usr/local

    # miniforge install 
    yum install -y dnf-plugins-core
    yum config-manager --set-enabled powertools || true
    yum install -y $REPO1 \
        xorg-x11-apps \
        git \
        gcc-gfortran \
        make \
        gcc \
        gcc-c++ \
        rsync \
        openssh-clients

    cd /opt
    curl -L -o Miniforge3.sh https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh

    bash Miniforge3.sh -b -p /opt/conda
    /opt/conda/bin/mamba update -y conda
    /opt/conda/bin/mamba update -y --all
    /opt/conda/bin/mamba install -y \
        ipython matplotlib-base pyqt numpy opencv cartopy astropy sunpy \
        gspread oauth2client jupyter compilers cmake make pybind11

    /opt/conda/bin/mamba clean -a -y

    # pyR2D2
    export PATH=/opt/conda/bin:$PATH
    export CC=/opt/conda/bin/x86_64-conda-linux-gnu-cc
    export CXX=/opt/conda/bin/x86_64-conda-linux-gnu-c++
    export FC=/opt/conda/bin/x86_64-conda-linux-gnu-gfortran
    export F77=$FC
    export F90=$FC

    mkdir -p /opt/source
    cd /opt/source
    git clone https://github.com/hottahd/pyR2D2.git
    cd pyR2D2
    /opt/conda/bin/pip install .



    cat <<EOF | tee -a /etc/oidc-agent/pubclients.config
hpci-pub@https://metis.hpci.nii.ac.jp/auth/realms/HPCI/@openid hpci offline_access
scitokens
EOF

    # ----- Prompt setting (force singularity to use the custom prompt)
    CUSTOM_ENV=/.singularity.d/env/99-zz_custom_env.sh
    cat >$CUSTOM_ENV <<EOF
#!/bin/bash
PS1="\[\e[1;33m\](sing):\h:\[\e[0;36m\]\w# \[\e[m\]"
EOF