# pyR2D2 解析コンテナ（uv 版）
#   ★このファイルは「どう生まれたか」の記録★。残すのは焼いた pyR2D2.sif のほう。
#   焼き方:  apptainer build --fakeroot pyR2D2.sif pyR2D2.def
Bootstrap: docker
# ★新しいものが出たら新しいもので焼く★（版は固定しない）
#   再現性は「焼いた .sif を データと一緒に残す」ことで担保している。
#   何で焼けたかは コンテナ内の /opt/versions.txt に残る。
From: ubuntu:latest

%labels
    Author   Hideyuki Hotta
    Version  v0.2.0
    Built    2026-09-17
    Base     ubuntu:latest（焼いた日のもの。中身は /opt/versions.txt）
    Python   3.13
    pyR2D2   master（焼いた日のもの。commit は /opt/versions.txt）
    Note     miniforge から uv に移した（画像が小さく、入れるのが速い）

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    # ---- OS 側 ----
    #   build-essential は ★pyR2D2 の C++20 拡張を建てるため★（ubuntu 24.04 の gcc は 13）
    #   libgl1 以下は ★PyQt6 と OpenCV が実行時に欲しがる★ もの
    apt-get -y update
    apt-get -y install --no-install-recommends \
        ca-certificates curl git build-essential gfortran \
        rsync openssh-client x11-apps fontconfig \
        libgl1 libegl1 libglib2.0-0t64 libdbus-1-3 \
        libxkbcommon-x11-0 libxcb-cursor0 libxcb-icccm4 libxcb-image0 \
        libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 libxcb-shape0 \
        libxcb-xinerama0 libxcb-xfixes0

    # Microsoft Core Fonts（EULA を先に承諾しておく。対話で止まるのを防ぐ）
    echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula boolean true" | debconf-set-selections
    apt-get -y install ttf-mscorefonts-installer
    fc-cache -f
    rm -rf /var/lib/apt/lists/*

    # ---- uv（いちばん新しいもの）----
    export UV_INSTALL_DIR=/usr/local/bin
    curl -LsSf https://astral.sh/uv/install.sh | sh

    # ---- Python と解析道具 ----
    #   ★venv は /opt/venv★（$HOME はホスト側を bind するので、家の中には置かない）
    export UV_PYTHON_INSTALL_DIR=/opt/python
    export UV_LINK_MODE=copy
    uv python install 3.13
    uv venv --python 3.13 /opt/venv
    export VIRTUAL_ENV=/opt/venv

    #   conda 版からの読み替え: matplotlib-base→matplotlib / pyqt→pyqt6 /
    #                          opencv→opencv-python-headless
    uv pip install \
        ipython jupyter \
        numpy scipy matplotlib pyqt6 \
        astropy sunpy cartopy opencv-python-headless zarr \
        gspread oauth2client

    # ---- pyR2D2（★PyPI に無いので git から★。C++ 拡張はここで建つ）----
    #   ★master 追随★ — 版を刺さなくても、どの commit で焼けたかは
    #   /opt/versions.txt の pip freeze に ★commit ごと★ 残る（uv がそう書く）。
    #   コンテナの中で pyR2D2.__version__ を見ても分かる（setuptools_scm）。
    uv pip install "pyR2D2 @ git+https://github.com/hottahd/pyR2D2@master"

    # ★作図の既定をイメージに焼き込む★（2026-09-17）
    #   原本は ★configuration/python/matplotlib/matplotlibrc★（非公開リポなので写しを置く）。
    #   ☠★mpl-data/matplotlibrc は丸ごと置き換えてはいけない★☠ あれは ★全キーを含む雛形★ で、
    #     欠けると import 時に KeyError: 'backend_fallback' で落ちる（2026-09-17 に踏んだ）。
    #     → ★該当キーの行だけ書き換える★。
    #   ここは「インストール既定」の層なので、
    #   ・/scr を bind し忘れても 図が DejaVu Sans に落ちない
    #   ・/scr を bind すれば ~/.config/matplotlib/matplotlibrc が ★上書きして勝つ★
    /opt/venv/bin/python - <<'MPLEOF'
import matplotlib, os, re
want = {
    "axes.prop_cycle": "cycler(color=['7b85d4', 'f37738', '83c995', 'd7369e', 'ad5d50', 'e9d943'])",
    "interactive": "True",
    "font.size": "18",
    "font.family": "serif",
    "font.serif": "Times New Roman, Liberation Serif, DejaVu Serif",
    "image.cmap": "inferno",
    "mathtext.fontset": "stix",
    "lines.linewidth": "1.5",
}
p = os.path.join(os.path.dirname(matplotlib.__file__), "mpl-data", "matplotlibrc")
out, seen = [], set()
for line in open(p).read().splitlines():
    m = re.match(r"^#?\s*([A-Za-z0-9_.]+)\s*:", line)
    k = m.group(1) if m else None
    if k in want and k not in seen:
        out.append("%s: %s" % (k, want[k])); seen.add(k)
    else:
        out.append(line)
out += ["%s: %s" % (k, v) for k, v in want.items() if k not in seen]
open(p, "w").write("\n".join(out) + "\n")
print("  matplotlibrc を書き換えた:", p, "(%d 項目)" % len(want))
MPLEOF
    /opt/venv/bin/python -c 'import matplotlib; print("  既定の字体:", matplotlib.rcParams["font.family"], matplotlib.rcParams["font.size"])'

    # ---- ★何で焼けたかを画像の中に残す★（版を固定しない代わりに ここに書く）----
    { echo "# built: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
      echo "# base:  $(. /etc/os-release; echo "$PRETTY_NAME")"
      echo "# uv:    $(uv --version)"
      echo "# python: $(/opt/venv/bin/python -V)"
    } > /opt/versions.txt
    uv pip freeze >> /opt/versions.txt
    /opt/venv/bin/python - >> /opt/versions.txt <<'PY'
import pyR2D2
print("# pyR2D2 version:", getattr(pyR2D2, "__version__", "?"))
PY
    uv cache clean

    # ---- プロンプト（コンテナの中だと分かるように）----
    cat > /.singularity.d/env/99-zz_custom_env.sh <<'EOF'
#!/bin/bash
PS1="\[\e[1;33m\](apptainer):\h:\[\e[0;36m\]\w# \[\e[m\]"
EOF

%environment
    export VIRTUAL_ENV=/opt/venv
    export PATH=/opt/venv/bin:$PATH

%test
    # ★焼くたびに ここで確かめる★（apptainer build は既定で %test を走らせる）
    set -eu
    # ☠★%test は読み取り専用・HOME=/root で走る★☠（2026-09-17 に踏んだ）
    #   matplotlib も sunpy も設定ディレクトリを作ろうとして落ちるので、/tmp へ逃がす
    export HOME=/tmp MPLCONFIGDIR=/tmp/mpl SUNPY_CONFIGDIR=/tmp/sunpy \
           XDG_CONFIG_HOME=/tmp XDG_CACHE_HOME=/tmp
    /opt/venv/bin/python - <<'PY'
import matplotlib; matplotlib.use("Agg")
import numpy, scipy, matplotlib.pyplot, astropy, sunpy, cartopy, cv2, zarr, gspread, IPython
import PyQt6.QtWidgets                      # X の共有ライブラリが揃っているか
import pyR2D2                               # C++ 拡張まで読めるか
print("  ok: python", __import__("sys").version.split()[0],
      "/ numpy", numpy.__version__, "/ cartopy", cartopy.__version__)
PY

%runscript
    exec jupyter notebook "$@"

%help
    pyR2D2 の解析環境（Python 3.13 / uv）。
      ./pyR2D2.sh shell   … 中でシェルを使う
      ./pyR2D2.sh run     … jupyter notebook を出す
    入っている版の一覧は コンテナ内の /opt/versions.txt。
