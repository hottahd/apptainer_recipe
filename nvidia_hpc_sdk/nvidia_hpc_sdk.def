Bootstrap: docker
From: nvcr.io/nvidia/nvhpc:26.5-devel-cuda_multi-ubuntu24.04

%labels
    Author Hideyuki Hotta
    Version v0.1.0

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get -y update
    apt-get -y install --no-install-recommends nlohmann-json3-dev libyaml-cpp-dev
    rm -rf /var/lib/apt/lists/*

    # ----- Prompt setting (force singularity to use the custom prompt)
    CUSTOM_ENV=/.singularity.d/env/99-zz_custom_env.sh
    cat >$CUSTOM_ENV <<EOF
#!/bin/bash
PS1="\[\e[1;33m\](app):\h:\[\e[0;36m\]\w# \[\e[m\]"
EOF

%runscript
    echo "HPC SDK container ready. Run your commands!"

%test
    # ★焼くたびに ここで確かめる★ コンパイラと入れたヘッダが揃っているか
    set -eu
    # ☠★%test は読み取り専用・HOME=/root で走る★☠（2026-09-17 に踏んだ）
    #   matplotlib も sunpy も設定ディレクトリを作ろうとして落ちるので、/tmp へ逃がす
    export HOME=/tmp MPLCONFIGDIR=/tmp/mpl SUNPY_CONFIGDIR=/tmp/sunpy \
           XDG_CONFIG_HOME=/tmp XDG_CACHE_HOME=/tmp
    # ★nvfortran/nvc++ は1行目が空行★ なので2行目を出す
    nvc++     --version | sed -n 2p
    nvfortran --version | sed -n 2p
    # ☠★GPU の確認は %test ではできない☠★ — build は --nv 無しで走るため。
    #   焼いたあと ★apptainer exec --nv <sif> nvaccelinfo★ で
    #   Default Target が期待の cc（astana の 4090 なら cc89）か見ること
    test -e /usr/include/nlohmann/json.hpp
    test -e /usr/include/yaml-cpp/yaml.h
    echo "  ok: HPC SDK とヘッダが揃っている"
