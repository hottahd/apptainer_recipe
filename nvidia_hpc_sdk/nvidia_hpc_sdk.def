Bootstrap: docker
From: nvcr.io/nvidia/nvhpc:26.5-devel-cuda_multi-ubuntu24.04

%labels
    Author Hideyuki Hotta
    Version v0.1.0

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get -y update
    apt-get -y install --no-install-recommends nlohmann-json3-dev libyaml-cpp-dev
    rm -rf /var/lib/apt/lists/*

    # ----- Prompt setting (force singularity to use the custom prompt)
    CUSTOM_ENV=/.singularity.d/env/99-zz_custom_env.sh
    cat >$CUSTOM_ENV <<EOF
#!/bin/bash
PS1="\[\e[1;33m\](app):\h:\[\e[0;36m\]\w# \[\e[m\]"
EOF

%runscript
    echo "HPC SDK container ready. Run your commands!"

%test
    # ★焼くたびに ここで確かめる★ コンパイラと入れたヘッダが揃っているか
    set -eu
    nvc++ --version | head -1
    nvfortran --version | head -1
    test -e /usr/include/nlohmann/json.hpp
    test -e /usr/include/yaml-cpp/yaml.h
    echo "  ok: HPC SDK とヘッダが揃っている"
